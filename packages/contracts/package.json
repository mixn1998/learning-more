{
  "name": "@learning-more/contracts",
  "version": "0.0.0-development",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "zod": "4.4.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "schema:check": "pnpm build && node scripts/check-openapi.mjs",
    "schema:generate": "pnpm build && node scripts/check-openapi.mjs --write",
    "test": "vitest run --root ../.. packages/contracts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
